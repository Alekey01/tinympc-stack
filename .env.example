# Copiar a .env (o ponerlas en "Environment" del stack en Komodo). NUNCA subir .env.

# Cuenta de Cuby (lectura de sensores por nova y comandos al aire por la v2)
CUBY_USUARIO=
CUBY_CLAVE=
# MAC del TERRA que se controla
TERRA_MAC=F09E9E1EB52C

# enviar (por defecto): el ESP32 decide y se manda al aire.
# sombra: el ESP32 decide y se registra, pero NO se manda nada (para pruebas).
# Solo un sistema debe controlar el aire a la vez.
MODO_ENVIO=enviar

# Broker MQTT al que se conecta el ESP32
MQTT_USUARIO=tinympc
MQTT_CLAVE=
MQTT_PUERTO=1883
# Identificador de la placa en los topics tinympc/<PLACA_ID>/...
PLACA_ID=cocina

# Panel web (usuario y contrasena obligatorios: muestra datos de la oficina)
PANEL_USUARIO=
PANEL_CLAVE=
PANEL_PUERTO=8765
