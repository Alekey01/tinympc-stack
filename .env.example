# Copiar a .env (o ponerlas en "Environment" del stack en Komodo). NUNCA subir .env.

# Cuenta de Cuby (lectura de sensores por nova y comandos al aire por la v2)
CUBY_USUARIO=
CUBY_CLAVE=
# MAC del TERRA que se controla
TERRA_MAC=F09E9E1EB52C

# enviar (por defecto): el ESP32 decide y se manda al aire.
# sombra: el ESP32 decide y se registra, pero NO se manda nada (para pruebas).
# Solo un sistema debe controlar el aire a la vez.
MODO_ENVIO=enviar

# Broker MQTT al que se conecta el ESP32
MQTT_USUARIO=tinympc
MQTT_CLAVE=
# eco | normal | confort (objetivo y techo sobre la temperatura del usuario)
MODO_MPC=normal
# 1: usar el horario aprendido para pre-enfriar antes de que llegue gente.
# 0: solo cuenta la gente detectada en los ultimos 30 min (la cocina: su TERRA
#    no ve el efecto del aire y anticipar lo dejaba encendido en vacio).
ANTICIPAR=0
# Identificador de la placa en los topics tinympc/<PLACA_ID>/...
PLACA_ID=cocina

# Panel web (usuario y contrasena obligatorios: muestra datos de la oficina)
PANEL_USUARIO=
PANEL_CLAVE=

# Por donde entra cada cosa (Traefik, HTTPS con el certificado *.cubytest.space)
PANEL_DOMINIO=tinympc.cubytest.space
MQTT_DOMINIO=mqtt-tinympc.cubytest.space
TRAEFIK_ENTRYPOINT=websecure
